# Database
# Set this BEFORE the first `docker compose up`. Postgres keeps the password it
# was first initialised with in the pgdata volume, so changing it later breaks
# the API (auth failures). To change it afterwards, run ALTER USER inside the db
# container, or `docker compose down -v` (destroys all data).
DB_PASSWORD=changeme
# DATABASE_URL is built by docker-compose.yml from DB_PASSWORD; don't set it here.
# Only set it when running the API outside compose, e.g.
# DATABASE_URL=postgresql+psycopg://biblioplex:<password>@localhost:5432/biblioplex

# Embeddings
HF_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_EMBED_DIM=384
HF_EMBED_DEVICE=cpu
EMBED_BATCH=256

# Ingest
BULK_SOURCE_TYPE=default_cards

# Runtime
WEB_CONCURRENCY=1
CORS_ORIGINS=
LOG_LEVEL=INFO

# Optional DSL fragment AND-ed onto every /cards/search query before parse.
# Server-side deployment-wide scoping — the API enforces this whether or
# not clients know. Example: SEARCH_DEFAULT_FILTER=game:paper f:commander
# restricts the whole API to paper-legal commander cards.
#
# Distinct from DEFAULT_Q below: SEARCH_DEFAULT_FILTER hides matching
# rows from every consumer (agents, curl, the web UI); DEFAULT_Q only
# seeds the web UI's search input on page load and does nothing on the
# API side. Setting one without the other is a footgun:
#   * SEARCH_DEFAULT_FILTER set, DEFAULT_Q empty → the UI's blank-box
#     search silently returns a filtered corpus, and removing "f:commander"
#     from the box doesn't unlock the rest — because the box never had it
#     in the first place, the API is enforcing it invisibly.
#   * SEARCH_DEFAULT_FILTER empty, DEFAULT_Q set → the UI seeds a filter
#     the user can edit off; agents see the full corpus.
# Keep the two matched unless you have a reason to diverge.
SEARCH_DEFAULT_FILTER=game:paper f:commander

# When true, the API auto-kicks /admin/refresh at startup if `cards` is empty.
# Disable on read-only replicas or when you want manual control over ingest.
AUTO_REFRESH_IF_EMPTY=true

# UI initial search-box query (rendered into web/app.js at container start
# via envsubst; changes need `make web-reload`, not `docker compose restart web`).
# Leave blank for no auto-search on page load. See SEARCH_DEFAULT_FILTER above
# for how this interacts with server-side filtering.
DEFAULT_Q=game:paper f:commander

# Commander Spellbook bulk combo file, on by default. Set it to an empty
# value to disable the combo ingest step. Refreshes download it once
# (~32 MB gzipped) and populate the `combos` side table (best-effort —
# fetch failure keeps the previous combos intact and the cards refresh
# committed).
COMBOS_SOURCE_URL=https://json.commanderspellbook.com/variants.json.gz

# Bearer token gating the /mcp mount. Leave EMPTY for local dev
# (no auth check). In prod, set to a strong random hex so anon callers
# can't reach the read tool catalog + corpus:
#   openssl rand -hex 32
# Clients then pass `Authorization: Bearer <token>` on every /mcp request:
#   claude mcp add --transport http --header "Authorization: Bearer $MCP_AUTH_TOKEN" \
#     biblioplex http://localhost:8000/mcp
MCP_AUTH_TOKEN=

# Host interface the api (8000) and web (8080) ports are published on.
# Default 127.0.0.1 = reachable from this machine only. The mutating
# endpoints are unauthenticated, so only set 0.0.0.0 on a trusted LAN
# (or put an authenticating reverse proxy in front; see SECURITY.md).
BIND_ADDR=127.0.0.1
